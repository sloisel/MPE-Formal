#!/usr/bin/env bash
# Stand-in for landrun, comparator's Landlock sandbox: skips the sandbox
# flags and executes the wrapped command directly, preserving any later "--"
# (which the real landrun's flag parser would consume -- see the comment in
# comparator.sh).  Removing the sandbox is sound here ONLY because the
# Solution being checked is this repository's own code, already built by the
# regular CI step.
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
  case "${args[$i]}" in
    --ro|--rw|--rwx|--rox|--env) i=$((i+2));;
    --best-effort|-ldd|-add-exec) i=$((i+1));;
    *) break;;
  esac
done
exec "${args[@]:$i}"
